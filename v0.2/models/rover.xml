    </body>
  </worldbody>
  <actuator>
    <general name="left_motor" joint="left_axle" dyntype="filterexact" dynprm="0.08" gaintype="fixed" gainprm="1" biastype="none" ctrllimited="true" ctrlrange="-1.5 1.5" forcelimited="true" forcerange="-1.5 1.5"/>
