      <geom name="hull" type="box" size="0.26 0.18 0.07" mass="6" rgba="0.10 0.60 0.68 1"/>
      <site name="imu" pos="0 0 0"/>
      <body name="left_wheel" pos="0 0.23 -0.10">
        <joint name="left_axle" axis="0 1 0"/>
        <geom name="left_tire" type="cylinder" size="0.12 0.035" euler="1.57079632679 0 0" mass="0.3" priority="1" condim="4" friction="0.9 0.005 0.0005" rgba="0.08 0.09 0.11 1"/>
